{
  "name": "@gumply/desktop",
  "version": "0.9.2",
  "private": true,
  "description": "Gumply",
  "license": "MIT",
  "author": {
    "name": "Gumply",
    "email": "noreply@gumply.invalid"
  },
  "homepage": "https://github.com/arslanarm/gumply",
  "desktopName": "gumply.desktop",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux AppImage deb --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "check:fuses": "node scripts/check-fuses.mjs --release release"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "6.8.11",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "app.gumply.desktop",
    "productName": "Gumply",
    "artifactName": "Gumply-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arslanarm",
        "repo": "gumply",
        "releaseType": "release"
      }
    ],
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "gumply",
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Notes as plain Markdown, with links, a graph and whiteboards",
      "description": "Gumply keeps your notes as plain Markdown files in a folder you choose (any Obsidian vault works), with a Notion-style editor, links, a graph and whiteboards.",
      "maintainer": "Gumply <noreply@gumply.invalid>",
      "syncDesktopName": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "appImage": {
      "executableArgs": []
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Gumply-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    }
  }
}
