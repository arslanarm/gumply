{
  "name": "@gumply/server",
  "version": "0.9.3",
  "private": true,
  "description": "Local Gumply server: vault file API, link index, graph and search.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./start": {
      "types": "./dist/start.d.ts",
      "default": "./dist/start.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@gumply/core": "*",
    "@hono/node-server": "^1.13.8",
    "fflate": "0.8.3",
    "hono": "^4.7.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3"
  }
}
