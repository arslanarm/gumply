{
  "name": "gumply",
  "version": "0.8.2",
  "private": true,
  "description": "Gumply — Notion-simple notes with Obsidian-style links and graph view.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run build -w @gumply/core",
    "dev": "concurrently -k -n core,server,web -c blue,green,magenta \"npm:dev:core\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:core": "npm run dev -w @gumply/core",
    "dev:server": "npm run dev -w @gumply/server",
    "dev:web": "npm run dev -w @gumply/web",
    "build": "npm run build -w @gumply/core && npm run build -w @gumply/server && npm run build -w @gumply/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "test:e2e:screens": "playwright test --config e2e/playwright.screens.config.ts",
    "desktop:dev": "npm run dev -w @gumply/desktop",
    "desktop:build:linux": "npm run dist:linux -w @gumply/desktop",
    "desktop:test": "npm run build -w @gumply/desktop && node apps/desktop/scripts/test.mjs",
    "seed:big": "node scripts/seed-big.mjs",
    "emoji:data": "node scripts/build-emoji-data.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prevault:sync-filenames": "npm run build -w @gumply/core && npm run build -w @gumply/server",
    "vault:sync-filenames": "node scripts/sync-filenames.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^3.0.5"
  }
}
