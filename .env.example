# Copy to .env (or export in your shell) as needed.
# Absolute or repo-relative path of the Markdown vault.
GUMPLY_VAULT=./vault
# API port used by apps/server and the Vite dev proxy (D7).
GUMPLY_PORT=8787
# Seed the demo vault on an empty first run (0 disables, e.g. for automation).
GUMPLY_SEED_DEMO=1
