filters:
  and:
    - file.folder == "Notion import/Private & Shared/Test page/Boardview"
views:
  - type: table
    name: Table
    order:
      - file.name
      - Assign
  - type: kanban
    name: Board
    groupBy:
      property: Status
      direction: ASC
    groupOrder:
      - Not started
      - In progress
      - Done
    order:
      - file.name
      - Assign
