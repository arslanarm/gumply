filters:
  and:
    - file.folder == "Notion import/Private & Shared/Projects/Tasks"
views:
  - type: table
    name: Table
    order:
      - file.name
      - Due
      - Priority 1 5
      - Done
      - Tags
      - Owner
      - Notes
  - type: kanban
    name: Board
    groupBy:
      property: Status
      direction: ASC
    groupOrder:
      - Todo
      - Doing
      - Done
    order:
      - file.name
      - Due
      - Priority 1 5
      - Done
      - Tags
      - Owner
      - Notes
