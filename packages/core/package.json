{
  "name": "@gumply/core",
  "version": "0.9.2",
  "private": true,
  "description": "Shared types, note/frontmatter parsing and wikilink helpers for Gumply.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b --pretty false",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
